# Example environment for compose.yml / local runs. Copy to .env and adjust.

# Comma-separated origins allowed to call the REST API directly (the bundled frontend
# goes through its own /api proxy and doesn't need this).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Self-registration is only open until the first account exists (which becomes admin).
# Set to true to let anyone register additional (non-admin) accounts.
ALLOW_REGISTRATION=false

# Max upload size for ML datasets and backup restores, in MB.
MAX_UPLOAD_MB=20

# --- Demo seed (scripts/seed_demo.py) -- DEV ONLY, throwaway credentials ---
SEED_API_URL=http://localhost:8000
DEMO_ADMIN_NAME=demo-admin
DEMO_ADMIN_PASSWORD=demo-admin-pass-2026
DEMO_USER_NAME=demo-user
DEMO_USER_PASSWORD=demo-user-pass-2026
