# Example environment for compose.yml / local runs. Copy to .env and adjust.

# --- Ports (compose) ---
# Host port for the web app. On Windows, Hyper-V sometimes reserves 3000 -- check with
# `netsh interface ipv4 show excludedportrange protocol=tcp` and pick e.g. 8080.
FRONTEND_PORT=3000
# The REST API and MCP server are published on loopback only; set 0.0.0.0 to expose them.
BACKEND_BIND_ADDRESS=127.0.0.1
MCP_BIND_ADDRESS=127.0.0.1

# --- REST API ---
# Comma-separated origins allowed to call the REST API directly (the bundled frontend
# goes through its own /api proxy and doesn't need this).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Self-registration is only open until the first account exists (which becomes admin).
# Set to true to let anyone register additional (non-admin) accounts.
ALLOW_REGISTRATION=false

# Max upload size for ML datasets and backup restores (REST and MCP), in MB.
MAX_UPLOAD_MB=20

LOG_LEVEL=INFO

# Where the SQLite files and CSV exports live when running outside a container
# (defaults: ./databases and ./csv_exports).
# KPI_DB_DIR=./databases
# KPI_EXPORT_DIR=./csv_exports

# --- MCP server ---
# HTTP transport: the URL clients use, and the Host headers accepted when it listens on a
# non-loopback address (DNS-rebinding protection). Add your host name when exposing it.
MCP_PUBLIC_URL=http://localhost:8001
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# Stdio transport (local clients only): who writes are attributed to, and whether the local
# operator may use the admin tools (users, password resets, restore).
MCP_STDIO_USER=mcp_agent
MCP_STDIO_ADMIN=true

# --- Demo seed (scripts/seed_demo.py) -- DEV ONLY, throwaway credentials ---
SEED_API_URL=http://localhost:8000
DEMO_ADMIN_NAME=demo-admin
DEMO_ADMIN_PASSWORD=demo-admin-pass-2026
DEMO_USER_NAME=demo-user
DEMO_USER_PASSWORD=demo-user-pass-2026
